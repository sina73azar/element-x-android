<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivImage"
        android:layout_width="@dimen/ui_img_medium"
        android:layout_height="@dimen/ui_img_medium"
        app:srcCompat="@drawable/ic_contact_book"
        tools:ignore="VectorDrawableCompat"
        android:tint="@color/colorAccent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvName"
        style="@style/service_title_active"
        fontPath="fonts/Shabnam-Bold.ttf"
        android:layout_gravity="right"
        android:gravity="right"
        android:text="@string/app_name"
        app:layout_constraintStart_toEndOf="@+id/ivImage"
        android:layout_marginStart="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/tvMobileNo"
        android:fontFamily="@font/font_regular"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvMobileNo"
        style="@style/service_title_normal"
        android:layout_width="wrap_content"
        android:gravity="right"
        android:text="@string/app_name"
        android:fontFamily="@font/font_regular"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivImage"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        android:layout_marginStart="@dimen/_8sdp" />
    <View
        style="@style/line_style"
        android:layout_width="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
         />

</androidx.constraintlayout.widget.ConstraintLayout>