<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:layout_margin="@dimen/_8sdp"
    android:background="@drawable/strock_blue_border"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fontFamily="@font/font_regular"
        android:id="@+id/tvOwnerCheque"
        android:text="نام صاحب چک"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="@dimen/_8sdp"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:fontFamily="@font/font_regular"
        android:id="@+id/tvNameOwnerCheque"
        android:textColor="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="end"
        app:layout_constraintStart_toEndOf="@+id/tvOwnerCheque"
        android:layout_margin="@dimen/_8sdp"
        android:maxLength="30"
        android:ellipsize="end"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:fontFamily="@font/font_regular"
        android:id="@+id/tvNationaTitle"
        android:text="کد ملی/شناسه ملی"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/tvOwnerCheque"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="@dimen/_8sdp"
        android:maxLength="30"
        android:ellipsize="end"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:fontFamily="@font/font_regular"
        android:id="@+id/tvNational"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/tvNameOwnerCheque"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/_8sdp"
        app:layout_constraintStart_toEndOf="@+id/tvNationaTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        android:gravity="end"
        android:ellipsize="end"/>
</androidx.constraintlayout.widget.ConstraintLayout>