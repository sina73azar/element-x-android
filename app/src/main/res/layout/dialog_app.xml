<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_4sdp"
    android:background="@drawable/card_view_bg">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDialogHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/font_regular"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/ui_text_normal"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="خروج از برنامه" />

    <View
        android:id="@+id/line"
        style="@style/line_style"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDialogHeader" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvDialogDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_16sdp"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:lineSpacingExtra="@dimen/_4sdp"
        android:justificationMode="inter_word"
        android:textDirection="rtl"
        android:textSize="@dimen/ui_text_normal"
        app:layout_constraintEnd_toEndOf="@+id/tvDialogHeader"
        app:layout_constraintStart_toStartOf="@+id/tvDialogHeader"
        app:layout_constraintTop_toBottomOf="@+id/line"
        tools:ignore="MissingConstraints"
        tools:text="sadklmv"
        tools:targetApi="o" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAccpet"
        style="@style/button_blue_style"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:text="@string/ok"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnCancle"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/tvDialogDesc"
        app:layout_constraintTop_toBottomOf="@id/tvDialogDesc" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCancle"
        style="@style/button_cancle_style"
        android:layout_width="0dp"
        android:layout_height="@dimen/_36sdp"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:text="@string/cancel"
        app:layout_constraintBottom_toBottomOf="@+id/btnAccpet"
        app:layout_constraintEnd_toEndOf="@+id/tvDialogDesc"
        app:layout_constraintStart_toEndOf="@id/btnAccpet"
        app:layout_constraintTop_toTopOf="@id/btnAccpet" />


</androidx.constraintlayout.widget.ConstraintLayout>