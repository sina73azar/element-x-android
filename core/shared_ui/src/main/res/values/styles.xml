<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="AppTheme" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:windowBackground">@color/light_gray</item>
        <item name="android:screenOrientation">portrait</item>
        <item name="textInputStyle">
            @style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense
        </item>

    </style>

    <style name="normal_edit_text">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_44sdp</item>
        <item name="android:background">@null</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:textSize">@dimen/ui_text_normal</item>
        <item name="android:paddingStart">@dimen/ui_big_size</item>
        <item name="android:paddingEnd">@dimen/ui_big_size</item>
        <item name="android:layout_marginLeft">@dimen/ui_large_size</item>
        <item name="android:layout_marginRight">@dimen/ui_large_size</item>
        <item name="android:layout_marginTop">@dimen/ui_normal_size</item>
        <item name="android:textDirection">ltr</item>
        <item name="android:lines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="AppSearchView" parent="Widget.AppCompat.SearchView">
        <item name="android:textSize">@dimen/ui_text_small</item>
    </style>

    <style name="button_blue_style" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:background">@drawable/blue_button</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:layout_marginRight">@dimen/content_from_edge</item>
        <item name="android:layout_marginLeft">@dimen/content_from_edge</item>
        <item name="spinning_bar_width">2dp</item>
        <item name="spinning_bar_color">@color/white</item>
        <item name="spinning_bar_padding">6dp</item>
        <item name="finalCornerAngle">@dimen/ui_radius_button</item>
        <item name="initialCornerAngle">@dimen/ui_radius_button</item>
    </style>

    <style name="button_cancle_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:background">@drawable/cancle_btn_bg</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:textColor">@color/gray</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:layout_marginRight">@dimen/_8sdp</item>
        <item name="android:layout_marginLeft">@dimen/_8sdp</item>

    </style>

    <style name="line_style">
        <item name="android:background">@color/gray_opacity_70</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
    </style>
    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowIsFloating">false</item>
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="button_blue_timer_style" parent="Widget.MaterialComponents.CircularProgressIndicator">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:background">@drawable/solid_blue</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingLeft">@dimen/ui_normal_size</item>
        <item name="android:paddingRight">@dimen/ui_normal_size</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:gravity">center</item>
        <item name="spinning_bar_width">2dp</item>
        <item name="spinning_bar_color">@color/white</item>
        <item name="spinning_bar_padding">6dp</item>
        <item name="finalCornerAngle">@dimen/ui_normal_size</item>
        <item name="initialCornerAngle">@dimen/ui_normal_size</item>
    </style>
    <style name="iban_lable">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:text">@string/irr_iban</item>
        <item name="android:textColor">@color/gray_opacity_70</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="service_title_active">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textColor">@color/colorPrimary</item>
    </style>
    <style name="service_title_normal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:layout_centerHorizontal">true</item>
        <item name="android:textColor">@color/service_segment_normal</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="ir_currency_txt">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:layout_marginEnd">@dimen/_8sdp</item>
        <item name="android:layout_marginRight">@dimen/_8sdp</item>
    </style>
    <style name="normal_hint_txt">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:layout_marginStart">@dimen/_8sdp</item>
        <item name="android:layout_marginEnd">@dimen/_8sdp</item>
        <item name="android:justificationMode" tools:targetApi="o">inter_word</item>
    </style>
    <style name="share_item_style">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/_40sdp</item>
        <item name="android:background">@color/light_gray</item>
    </style>
    <style name="normal_title_txt">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/font_regular</item>
        <item name="android:textSize">@dimen/ui_text_small</item>
        <item name="android:layout_marginTop">@dimen/_8sdp</item>
        <item name="android:layout_marginStart">@dimen/_16sdp</item>
        <item name="android:layout_marginLeft">@dimen/_16sdp</item>
        <item name="android:lineSpacingExtra">@dimen/_8sdp</item>
    </style>
</resources>