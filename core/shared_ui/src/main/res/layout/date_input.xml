<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/content_from_edge">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/txtValueIl"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layoutDirection="ltr"
        app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
        app:boxCornerRadiusBottomStart="@dimen/_8sdp"
        app:boxCornerRadiusTopEnd="@dimen/_8sdp"
        app:boxCornerRadiusTopStart="@dimen/_8sdp"
        app:boxStrokeColor="@color/my_outlined_stroke_color"
        app:endIconMode="clear_text"
        app:hintTextColor="@color/colorAccentDark"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:hint="@string/date_title">

        <androidx.appcompat.widget.AppCompatAutoCompleteTextView
            android:id="@+id/txtValue"
            style="@style/normal_edit_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_44sdp"
            android:layout_margin="0dp"
            android:clickable="true"
            android:focusable="false"
            android:fontFamily="@font/font_regular"
            android:gravity="center"
            android:imeOptions="actionNext"
            android:minHeight="?attr/actionBarSize"
            android:textSize="@dimen/ui_text_normal"
            tools:textDirection="rtl" />

    </com.google.android.material.textfield.TextInputLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
