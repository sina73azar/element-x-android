<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_view_bg">

    <View
        android:id="@+id/viewStroke"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="@drawable/strock_blue_border"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <RadioButton
        android:id="@+id/btnRadio"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_margin="@dimen/_8sdp"
        android:buttonTint="@color/colorPrimary"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="VectorDrawableCompat" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txtValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_8sdp"
        android:textColor="@color/gray_opacity_70"
        app:fontFamily="@font/font_regular"
        android:textSize="@dimen/ui_text_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/txtTitle"
        app:layout_constraintTop_toBottomOf="@id/btnRadio" />



    <com.drp.shared_ui.widget.xml.AmountTextVew
        android:id="@+id/txtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textColor="@color/colorPrimary"
        android:textSize="@dimen/ui_text_normal"
        app:fontFamily="@font/font_bold"
        android:ellipsize="end"
        android:maxLines="1"
        android:gravity="start"
        android:layout_marginStart="@dimen/_8sdp"
        app:layout_constraintStart_toEndOf="@+id/btnRadio"
        app:layout_constraintBottom_toBottomOf="@id/btnRadio"
        app:layout_constraintEnd_toStartOf="@+id/bankImg"
        app:layout_constraintTop_toTopOf="@+id/btnRadio" />

    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_24sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="@dimen/_12sdp"
        android:id="@+id/bankImg"/>

</androidx.constraintlayout.widget.ConstraintLayout>