<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomSheetLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/light_gray"
        android:elevation="@dimen/_10sdp"
        android:focusableInTouchMode="true"
        app:behavior_hideable="false"
        app:behavior_peekHeight="@dimen/_160sdp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.appcompat.widget.SearchView
            android:id="@+id/servicesSv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:background="@drawable/search_bg"
            android:focusable="true"
            android:iconifiedByDefault="false"
            android:paddingStart="@dimen/_30sdp"
            android:searchIcon="@null"
            android:textDirection="rtl"
            app:defaultQueryHint="@string/search_services_st"
            app:iconifiedByDefault="false"
            app:layout_constraintTop_toTopOf="parent"
            app:searchIcon="@null"
            app:theme="@style/AppSearchView" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/microPhoneIv"
            android:layout_width="@dimen/_24sdp"
            android:layout_height="@dimen/_24sdp"
            android:layout_margin="@dimen/_8sdp"
            android:elevation="@dimen/_5sdp"
            app:layout_constraintBottom_toBottomOf="@id/servicesSv"
            app:layout_constraintStart_toStartOf="@id/servicesSv"
            app:layout_constraintTop_toTopOf="@id/servicesSv"
            app:srcCompat="@drawable/ic_microphone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/servicesRv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:padding="@dimen/_8sdp"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/servicesSv" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>