<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/refah_icon_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_8sdp"
            android:tint="@color/colorPrimaryDark"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_share"
            tools:ignore="VectorDrawableCompat" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvTitleSheet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_normal_size"
            android:layout_marginLeft="8dp"
            android:fontFamily="@font/font_regular"
            android:text="@string/receipt_share"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/ui_text_normal"
            app:layout_constraintBottom_toBottomOf="@id/refah_icon_img"
            app:layout_constraintStart_toEndOf="@+id/refah_icon_img"
            app:layout_constraintTop_toTopOf="@id/refah_icon_img" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btnClosePopUp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="16dp"
            android:layout_marginRight="16dp"

            android:tint="@color/gray"
            app:layout_constraintBottom_toBottomOf="@id/refah_icon_img"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/refah_icon_img"
            app:srcCompat="@drawable/ic_done"
            tools:ignore="VectorDrawableCompat" />

        <View
            android:id="@+id/line"
            style="@style/line_style"
            android:layout_marginTop="@dimen/_8sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitleSheet" />


        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/line">

            <include
                android:id="@+id/img_share"
                layout="@layout/item_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/txt_share"
                layout="@layout/item_share"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.constraintlayout.widget.ConstraintLayout>


</RelativeLayout>