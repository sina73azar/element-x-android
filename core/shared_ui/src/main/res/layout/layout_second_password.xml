<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/content_from_edge">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearPassword"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/_8sdp"
        app:layout_constraintEnd_toStartOf="@+id/ivInfoPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/txtValueIl"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="rtl"
            android:gravity="center"
            app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
            app:boxCornerRadiusBottomStart="@dimen/_8sdp"
            app:boxCornerRadiusTopEnd="@dimen/_8sdp"
            app:boxCornerRadiusTopStart="@dimen/_8sdp"
            android:hint="@string/transfer_card_pin_hint"
            app:boxStrokeColor="@color/my_outlined_stroke_color"
            app:passwordToggleDrawable="@drawable/eye_password"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/colorPrimary"
            app:hintTextColor="@color/colorAccentDark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etActivationCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fontFamily="@font/font_regular"
                android:textColor="@color/black"
                android:textCursorDrawable="@null"
                android:gravity="center"
                android:maxLength="18"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textSize="@dimen/ui_text_normal" />

        </com.google.android.material.textfield.TextInputLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivInfoPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="@color/orange"
        android:visibility="gone"
        android:layout_marginTop="@dimen/_4sdp"
        android:layout_marginHorizontal="@dimen/icon_margin"
        app:layout_constraintBottom_toBottomOf="@id/linearPassword"
        app:layout_constraintStart_toEndOf="@id/linearPassword"
        app:layout_constraintEnd_toStartOf="@+id/topup_btn"
        android:background="?selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="@id/linearPassword"
        app:srcCompat="@drawable/ic_circle_info"
        tools:visibility="visible" />

    <br.com.simplepass.loadingbutton.customViews.CircularProgressButton
        android:id="@+id/topup_btn"
        style="@style/button_blue_timer_style"
        android:layout_marginStart="16dp"
        android:elevation="0dp"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:layout_marginTop="@dimen/_4sdp"
        android:text="@string/totp_title"
        android:textSize="@dimen/ui_text_micro"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/linearPassword"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/linearPassword"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/timer_cownt_txt"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:fontFamily="@font/font_regular"
        android:gravity="center"
        android:textColor="@color/gray"
        android:textSize="@dimen/ui_text_big"
        android:visibility="gone"
        app:fontFamily="@font/font_bold"
        app:layout_constraintBottom_toBottomOf="@id/topup_btn"
        app:layout_constraintStart_toStartOf="@id/topup_btn"
        app:layout_constraintTop_toTopOf="@id/topup_btn"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/timer_img"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ui_normal_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/timer_cownt_txt"
        app:layout_constraintEnd_toEndOf="@+id/topup_btn"
        app:layout_constraintStart_toEndOf="@+id/timer_cownt_txt"
        app:layout_constraintTop_toTopOf="@id/timer_cownt_txt"
        app:srcCompat="@drawable/ic_clock"
        tools:ignore="VectorDrawableCompat"
        tools:visibility="visible" />
</androidx.constraintlayout.widget.ConstraintLayout>